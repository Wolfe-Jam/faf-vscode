# Source + tooling — the shipped artifact is the esbuild bundle.
.vscode/**
.github/**
src/**
scripts/**
test/**
.smoke-storage/**
esbuild.js
tsconfig.json
tsconfig.integration.json
bunfig.toml
.vscode-test.mjs
out-integration/**
**/*.map
**/*.ts
.gitignore
.editorconfig

# node_modules: the esbuild bundle inlines faf-cli's *library* (dist/index.js),
# so this is a blanket ignore with an explicit allow-list. Keep:
#  - faf-scoring-kernel: the external WASM kernel the bundle loads at runtime.
#  - faf-cli/dist/*.js + package.json: cli.js is spawned by Init / Sync / DNA
#    (src/faf/run.ts); index.js is the require.resolve anchor. `dist/*.js`
#    (not `dist/**`) drops faf-cli's 2.7 MB of .js.map and its dist/**/*.d.ts.
#  - open + its FULL 12-package subtree: faf-cli's built cli.js has a static
#    top-level `import … from "open"`, so cli.js is DOA (Init/Sync/DNA all fail
#    from an installed .vsix) unless every transitive dep of open@11 resolves.
#    npm hoists them all top-level. Re-derive this list with:
#      node -e 'const s=new Set(),f=require("fs"),p=require("path");(function d(n){if(s.has(n))return;s.add(n);let j;try{j=JSON.parse(f.readFileSync(p.join("node_modules",n,"package.json")))}catch{return}for(const k of Object.keys(j.dependencies||{}))d(k)})("open");console.log([...s].sort())'
#    if a future faf-cli bumps `open`. The CI vsix-extract check (release.yml)
#    catches a regression here.
#  - faf-cli's optional @anthropic-ai/sdk is installed but never required at
#    runtime (stack-detection reads the string only) — stays ignored.
node_modules/**
!node_modules/faf-scoring-kernel/**
!node_modules/faf-cli/dist/*.js
!node_modules/faf-cli/package.json
!node_modules/open/**
!node_modules/bundle-name/**
!node_modules/default-browser/**
!node_modules/default-browser-id/**
!node_modules/define-lazy-prop/**
!node_modules/is-docker/**
!node_modules/is-in-ssh/**
!node_modules/is-inside-container/**
!node_modules/is-wsl/**
!node_modules/powershell-utils/**
!node_modules/run-applescript/**
!node_modules/wsl-utils/**
