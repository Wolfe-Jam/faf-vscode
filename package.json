{
  "name": "faf-context",
  "displayName": "FAF — Project Context",
  "description": "Show where your project.faf stands — score, tier, drift — and render its context card, without leaving the editor.",
  "version": "0.0.1",
  "publisher": "faf",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfe-Jam/faf-vscode.git"
  },
  "homepage": "https://faf.one",
  "bugs": {
    "url": "https://github.com/Wolfe-Jam/faf-vscode/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "faf",
    "ai-context",
    "project-dna",
    "agents-md"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:project.faf",
    "onWalkthrough:faf-context.gettingStarted"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Scoring and the context card work in untrusted workspaces; Init and Sync run the FAF CLI and are disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "faf-context",
          "title": "FAF Context",
          "icon": "resources/faf-context.svg"
        }
      ]
    },
    "views": {
      "faf-context": [
        {
          "id": "faf-context.hud",
          "name": "Project Context"
        }
      ]
    },
    "commands": [
      {
        "command": "faf-context.refresh",
        "title": "FAF: Refresh Score",
        "icon": "$(refresh)"
      },
      {
        "command": "faf-context.openCard",
        "title": "FAF: Open Context Card",
        "icon": "$(preview)"
      },
      {
        "command": "faf-context.openFaf",
        "title": "FAF: Open project.faf",
        "icon": "$(go-to-file)"
      },
      {
        "command": "faf-context.sync",
        "title": "FAF: Sync Context Files",
        "icon": "$(sync)"
      },
      {
        "command": "faf-context.init",
        "title": "FAF: Initialize project.faf",
        "icon": "$(add)"
      },
      {
        "command": "faf-context.showDna",
        "title": "FAF: Show DNA Journey",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "faf-context.openCard",
          "when": "view == faf-context.hud && faf-context.hasFaf",
          "group": "navigation@1"
        },
        {
          "command": "faf-context.refresh",
          "when": "view == faf-context.hud",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "faf-context.sync",
          "when": "view == faf-context.hud && viewItem == faf.drift",
          "group": "inline"
        },
        {
          "command": "faf-context.openCard",
          "when": "view == faf-context.hud && viewItem == faf.header",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "faf-context.refresh"
        },
        {
          "command": "faf-context.openCard",
          "when": "faf-context.hasFaf"
        },
        {
          "command": "faf-context.openFaf",
          "when": "faf-context.hasFaf"
        },
        {
          "command": "faf-context.sync",
          "when": "faf-context.hasFaf"
        },
        {
          "command": "faf-context.init",
          "when": "!faf-context.hasFaf"
        },
        {
          "command": "faf-context.showDna",
          "when": "faf-context.hasFaf"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "faf-context.gettingStarted",
        "title": "Get started with FAF",
        "description": "Author your project.faf, fill the six W's, and watch the score climb.",
        "steps": [
          {
            "id": "faf-context.walkthrough.init",
            "title": "Author your project.faf",
            "description": "FAF is your project's DNA for AI — one file, IANA-registered.\n[Author project.faf](command:faf-context.init)\nAlready have one? This step is done.",
            "media": {
              "markdown": "media/init.md"
            },
            "when": "!faf-context.hasFaf",
            "completionEvents": [
              "onContext:faf-context.hasFaf"
            ]
          },
          {
            "id": "faf-context.walkthrough.sixw",
            "title": "Fill the six W's",
            "description": "human_context — who / what / why / where / when / how — is where the score lives.\n[Open project.faf](command:faf-context.openFaf)",
            "media": {
              "markdown": "media/sixw.md"
            }
          },
          {
            "id": "faf-context.walkthrough.score",
            "title": "Watch the score climb",
            "description": "The status bar and the FAF Context sidebar track your score and tier live.\n[Open the context card](command:faf-context.openCard)",
            "media": {
              "markdown": "media/score.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "tsc -p tsconfig.integration.json && vscode-test",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "faf-cli": "^7.11.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
